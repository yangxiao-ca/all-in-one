# 学习架服务端配置示例
# 复制为 .env 或直接以环境变量方式传给 node server.mjs。
# 本地 Mac 上所有项都有默认值，通常什么都不用配。

# 监听地址。本机用默认值；放在反向代理后面也保持 127.0.0.1，由代理对外暴露。
# HOST=127.0.0.1

# 监听端口。
# PORT=47831

# 学习数据目录。默认跟随项目目录（<项目>/Learning/），git 全程跟踪。
# 如需外挂到其他 Obsidian 库，填入其根目录（服务会在其下找 Learning/ 子目录）。
# LEARNING_VAULT_ROOT=

# 额外允许的 Host 白名单（逗号分隔）。
# 部署在 Mac mini 上、由 Caddy 反代 learn.dream3398.cn 时必须配置，否则会 403。
# ALLOWED_HOSTS=learn.dream3398.cn

# 是否信任反向代理传来的 X-Forwarded-* 头（用于取真实客户端 IP 做限流）。
# TRUST_PROXY=0

# 每分钟写操作上限（防脚本误刷，单用户正常使用远低于此值）。
# WRITE_LIMIT_PER_MINUTE=120

# 设为 1 后拒绝所有写操作，线上站点变成纯浏览端。
# READ_ONLY=0

# 打开微信的命令覆盖（默认 macOS 用 `open -a WeChat`，其他平台返回 501）。
# WECHAT_OPEN_COMMAND=

# 设为 1 时在日志里输出每次请求的访问记录。
# ACCESS_LOG=0
